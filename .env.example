# Database connection string
DATABASE_URL="file:./dev.db"

# Authentication secret for JWT tokens / session verification
# REQUIRED: Generate a secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=""

# Environment
NODE_ENV="development"

# Carbon Coach Mode: "local" (default, deterministic) or "groq" (AI-powered, requires GROQ_API_KEY)
COACH_MODE="local"

# Groq API Key for Carbon Intelligence Coach (Optional - only used when COACH_MODE=groq)
GROQ_API_KEY=""

# Google OAuth 2.0 / OpenID Connect Configuration
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional redirect URI override (defaults to http://localhost:3000/api/auth/google/callback in local dev)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
