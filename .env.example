# Database connection string
DATABASE_URL="file:./dev.db"

# Authentication secret for JWT tokens / session verification
# REQUIRED: Generate a secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=""

# Environment
NODE_ENV="development"

# Carbon Coach Mode: "local" (default, deterministic) or "groq" (AI-powered, requires GROQ_API_KEY)
COACH_MODE="local"

# Groq API Key for Carbon Intelligence Coach (Optional - only used when COACH_MODE=groq)
GROQ_API_KEY=""
